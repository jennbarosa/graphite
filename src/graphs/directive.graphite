graph directive
  node line      @task:line
  node directive @task:directive
  node rest      @task:rest
  node done      end
  node failed    end

  edge line      -> line      when skipped
  edge line      -> directive when directive
  edge line      -> rest      when body
  edge line      -> failed    when failed
  edge directive -> line      when passed
  edge directive -> failed    when failed
  edge rest      -> done      when passed
  edge rest      -> failed    when failed
