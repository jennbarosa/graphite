graph grammar
  node next       @task:next
  node header     @task:header
  node body       @task:body
  node node_line  @task:node_line
  node edge_line  @task:edge_line
  node choose     @task:choose
  node arms       @task:arms
  node when_arm   @task:when_arm
  node else_arm   @task:else_arm
  node arm        @task:arm
  node arms_end   @task:arms_end
  node block_end  @task:block_end
  node graph_end  @task:graph_end
  node finished   end
  node failed     end

  edge next -> header    when more
  edge next -> finished  when finished
  edge next -> failed    when failed
  edge header -> body    when passed
  edge header -> failed  when failed
  edge body -> node_line when line_node
  edge body -> edge_line when line_edge
  edge body -> choose    when line_choose
  edge body -> block_end when line_end
  edge body -> failed    when failed
  edge node_line -> body   when passed
  edge node_line -> failed when failed
  edge edge_line -> body   when passed
  edge edge_line -> failed when failed
  edge choose -> arms    when passed
  edge choose -> failed  when failed
  edge arms -> when_arm  when arm_when
  edge arms -> else_arm  when arm_else
  edge arms -> arms_end  when arm_end
  edge arms -> failed    when failed
  edge when_arm -> arm    when passed
  edge when_arm -> failed when failed
  edge else_arm -> arm    when passed
  edge arm -> arms   when passed
  edge arm -> failed when failed
  edge arms_end -> body   when passed
  edge arms_end -> failed when failed
  edge block_end -> graph_end when passed
  edge block_end -> failed    when failed
  edge graph_end -> next   when passed
  edge graph_end -> failed when failed
