graph structure
  node degrees @task:degrees
  node offsets @task:offsets
  node reach   @task:reach
  node routes  @task:routes
  node done    end
  node failed  end

  edge degrees -> offsets when passed
  edge degrees -> failed  when failed
  edge offsets -> reach   when passed
  edge offsets -> failed  when failed
  edge reach   -> routes  when passed
  edge reach   -> failed  when failed
  edge routes  -> done    when passed
  edge routes  -> failed  when failed
